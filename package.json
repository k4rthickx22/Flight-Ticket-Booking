{
  "name": "flightbooking-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "parcel index.html --port 1234",
    "start": "parcel index.html --port 1234",
    "api": "json-server --watch db.json --port 3001",
    "dev:full": "concurrently \"npm run dev\" \"npm run api\"",
    "build": "parcel build index.html --dist-dir dist",
    "clean": "rm -rf .parcel-cache dist"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-datepicker": "^7.3.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.26.1",
    "react-slick": "^0.30.2",
    "react-toastify": "^10.0.5",
    "slick-carousel": "^1.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@parcel/transformer-js": "^2.12.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "json-server": "^0.17.4",
    "parcel": "^2.12.0",
    "process": "^0.11.10"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
