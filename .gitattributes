# Normalize all text files to LF in the repo; Git will handle CRLF on checkout for Windows
* text=auto eol=lf

# Explicitly mark binary files so Git never touches their line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.mp4  binary
*.webp binary
